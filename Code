import streamlit as st
import joblib
import pandas as pd

model = joblib.load("sleep_quality_rf_model.joblib")


st.set_page_config(page_title="AI Sleep Quality Predictor", layout="centered")
st.title("🌙 AI Sleep Quality Predictor")
st.write("Enter your health and lifestyle metrics below to find out your true sleep quality.")

st.header("📋 Your Profile Metrics")

col1, col2 = st.columns(2)

with col1:
    age = st.slider("Age", min_value=18, max_value=80, value=30)
    gender_input = st.selectbox("Gender", options=["Male", "Female"])

    sleep_duration = st.slider("Sleep Duration (Hours)", min_value=3.0, max_value=12.0, value=7.0, step=0.5)
    stress_level = st.slider("Stress Level (1-10)", min_value=1, max_value=10, value=5)
    heart_rate = st.slider("Resting Heart Rate (BPM)", min_value=50, max_value=100, value=70)

with col2:
    physical_activity = st.slider("Physical Activity Level (Minutes/Day)", min_value=0, max_value=120, value=45)
    daily_steps = st.slider("Daily Steps", min_value=1000, max_value=15000, value=6000, step=500)


    sbp = st.slider("Systolic Blood Pressure (Sbp)", min_value=90, max_value=160, value=120)
    dbp = st.slider("Diastolic Blood Pressure (Dbp)", min_value=60, max_value=100, value=80)

    bmi_input = st.selectbox("BMI Category", options=["Normal", "Overweight", "Obese"])
    sleep_disorder_input = st.selectbox("Sleep Disorder Status", options=["None", "Sleep Apnea", "Insomnia"])

    occupation_salesperson = st.checkbox("Are you a Salesperson?", value=False)


gender = 1 if gender_input == "Female" else 0
bmi_map = {"Normal": 0, "Overweight": 1, "Obese": 2}
bmi_category = bmi_map[bmi_input]


sleep_disorder_apnea = 1 if sleep_disorder_input == "Sleep Apnea" else 0

occ_salesperson = 1 if occupation_salesperson else 0



if st.button("🔮 Predict Sleep Quality", type="primary"):

    input_data = pd.DataFrame([{
        "Gender": gender,
        "Age": age,
        "Physical Activity Level": physical_activity,
        "Daily Steps": daily_steps,
        "Sbp": sbp,
        "Dbp": dbp,
        "BMI Category": bmi_category,
        "Occupation_Salesperson": occ_salesperson,
        "Sleep Disorder_Sleep Apnea": sleep_disorder_apnea
    }])
    prediction = model.predict(input_data)[0]

    st.success(f"### Predicted Sleep Quality Score: **{prediction:.1f} / 10**")

    st.write("---")
    st.subheader("💡 Personalized Lifestyle Insights:")

    if sleep_duration < 6.0:
        st.warning(f"⚠️ You logged only **{sleep_duration} hours** of sleep. Getting less than 6 hours can severely restrict cognitive recovery, regardless of your physical activity.")

    if stress_level >= 7:
        st.info(f"🧘 Your current Stress Level is high (**{stress_level}/10**). Since your AI model scored your sleep based on your physical metrics, practicing a 10-minute mindfulness routine can help lower your resting heart rate ({heart_rate} BPM) and improve future sleep patterns.")

    if sleep_duration >= 6.0 and stress_level < 7:
        st.success("✨ Your biological inputs (Sleep Duration and Stress Level) are in excellent alignment for restorative sleep!")
